# Local SQLite database used for development.
DATABASE_URL="file:./dev.db"

# Server-only provider credentials. Fill these in locally; never commit them.
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
DEEPGRAM_API_KEY=""

# Deepgram API region: "us" or "eu". Server-side only; the token route also
# returns it to the browser so STT/TTS sockets always use the same region the
# server records in its turn metrics.
DEEPGRAM_REGION="us"
