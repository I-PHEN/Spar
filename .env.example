# Database — Local SQLite for dev, or Supabase Postgres pooled + direct URLs for production
DATABASE_URL="file:./dev.db"
DIRECT_URL=""

# Supabase Auth & Database REST API (create project at supabase.com -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Launch Demo Video & Early Testers WhatsApp Community
NEXT_PUBLIC_DEMO_VIDEO_URL=""
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=""

# Server-only provider credentials. Fill these in locally; never commit them.
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
DEEPGRAM_API_KEY=""

# Deepgram API region: "us" or "eu". Server-side only; the token route also
# returns it to the browser so STT/TTS sockets always use the same region the
# server records in its turn metrics.
DEEPGRAM_REGION="us"

# Optional: Gemini API key for the Live voice engine (create one at aistudio.google.com).
GEMINI_API_KEY=""

# Creator Studio passkey (/studio)
STUDIO_PASSKEY="spar-studio"
